{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "eightsteppe.com" }],
      "destination": "https://eightsteppe.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.eightsteppe.com" }],
      "destination": "https://eightsteppe.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.eightsteppe.org" }],
      "destination": "https://eightsteppe.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "regions": ["hnd1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "content/*.json,server/schema.postgres.sql"
    }
  }
}
