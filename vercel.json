{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "regions": ["hnd1"],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "content/*.json,server/schema.postgres.sql"
    }
  }
}
