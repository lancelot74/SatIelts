# Local app: Vite uses 5173; production must use your HTTPS origin.
APP_ORIGIN=http://localhost:5173
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Configure this exact redirect URI in your Google OAuth web client.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Comma-separated Google account emails allowed to approve/revoke exam access.
ADMIN_EMAILS=
DATABASE_PATH=.data/studyroom.sqlite
# Set only behind a trusted reverse proxy in production.
TRUST_PROXY=0
