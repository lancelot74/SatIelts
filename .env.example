# Local app: Vite uses 5173. On Vercel set APP_ORIGIN=https://eightsteppe.org
# with no trailing slash. eightsteppe.com redirects to that origin.
APP_ORIGIN=http://localhost:5173
PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Configure this exact redirect URI in your Google OAuth web client.
# Production: https://eightsteppe.org/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Comma-separated emails kept for reference. Access control uses OWNER_GOOGLE_SUB.
ADMIN_EMAILS=
# Google subject (the "sub" claim) of the only owner. Required for /admin.
# Find it in the users table after that person signs in. Leave empty to fail closed.
OWNER_GOOGLE_SUB=
DATABASE_PATH=.data/studyroom.sqlite
# Supabase transaction pooler (port 6543). Leave empty to use the local SQLite file.
# Copy it from Supabase: Connect → Transaction pooler. Percent-encode reserved characters in the password.
DATABASE_URL=
# Connections per warm instance. Default 5. Integers 1 through 20.
PG_POOL_MAX=5
# Apply migrations during boot. Local and tests only. Leave unset in production.
# RUN_MIGRATIONS_ON_BOOT=1
# Set to disable only for a local Postgres server without SSL.
DATABASE_SSL=
# Set only behind a trusted reverse proxy in production. Vercel turns this on by itself.
TRUST_PROXY=0
# Generate locally (owner machine), set in Vercel, never commit:
# openssl rand -hex 32
SMS_WEBHOOK_TOKEN=
